# Variables de entorno para YnaCaja (Chicha Adictiva)

# URL de tu proyecto Supabase (Ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima de Supabase (anon public key)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL base de tu backend serverless en Cloudflare Pages
# Para producción en Android APK o web externa, pon la URL de tu Pages (Ejemplo: https://ynacaja.pages.dev)
# En desarrollo web local, déjalo vacío o usa http://localhost:8788
VITE_API_BASE_URL=https://ynacaja.pages.dev
